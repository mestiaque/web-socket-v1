# DynamicSocket configuration. Copy to .env and adjust.
# Real environment variables override values in this file.

# --- Network ---------------------------------------------------------------
DS_HOST=127.0.0.1
DS_PORT=6001
DS_WS_PATH=/ws
# Comma-separated IPs of reverse proxies whose X-Forwarded-For is trusted.
# Leave empty unless DynamicSocket sits behind a proxy you control.
DS_TRUSTED_PROXIES=

# --- Applications ------------------------------------------------------------
# Path to the applications file (see apps.example.json). Keep it out of git.
DS_APPS_FILE=./apps.json
# Alternatively provide the same JSON inline (takes precedence):
# DS_APPS_JSON=[{"id":"shop","keys":[{"id":"k1","secretEnv":"DS_SHOP_SECRET_K1"}],"allowedOrigins":["https://shop.example.com"]}]
# Secrets referenced via "secretEnv" in the apps file:
# DS_SHOP_SECRET_K1=replace-with-output-of-npm-run-app:generate

# --- Logging & metrics -------------------------------------------------------
DS_LOG_LEVEL=info
# Enables GET /metrics with "Authorization: Bearer <token>" (min 16 chars).
DS_METRICS_TOKEN=

# --- Limits --------------------------------------------------------------------
DS_MAX_CONNECTIONS=10000
DS_MAX_CONNECTIONS_PER_IP=100
DS_MAX_PAYLOAD_BYTES=16384
DS_MAX_PUBLISH_BODY_BYTES=65536
DS_MAX_PUBLISH_TARGETS=100
DS_MAX_SUBSCRIPTIONS_PER_CONNECTION=100
DS_MAX_BUFFERED_BYTES=1048576
# Max distinct users per presence channel
DS_PRESENCE_MAX_MEMBERS=1000

# --- Timeouts (milliseconds) ----------------------------------------------------
DS_AUTH_TIMEOUT_MS=10000
DS_HEARTBEAT_INTERVAL_MS=30000
DS_SHUTDOWN_TIMEOUT_MS=10000
DS_HTTP_REQUEST_TIMEOUT_MS=10000
DS_HTTP_HEADERS_TIMEOUT_MS=5000
DS_HTTP_KEEPALIVE_TIMEOUT_MS=5000
DS_SLOW_CONSUMER_GRACE_MS=2000
# Delay before announcing that a user left a presence channel (hides page reloads)
DS_PRESENCE_LEAVE_GRACE_MS=3000

# --- Client tokens ----------------------------------------------------------------
DS_TOKEN_MAX_TTL_SECONDS=900
DS_TOKEN_CLOCK_SKEW_SECONDS=30
DS_TOKEN_SINGLE_USE=true
# Authenticated sockets are closed (4000) after this long; 0 disables.
DS_MAX_SESSION_SECONDS=3600

# --- Signed HTTP API ----------------------------------------------------------------
DS_SIGNATURE_TOLERANCE_SECONDS=300
DS_NONCE_STORE_MAX=100000

# --- Rate limits --------------------------------------------------------------------
DS_CLIENT_RATE_PER_SEC=10
DS_CLIENT_RATE_BURST=20
DS_CLIENT_RATE_VIOLATIONS_BEFORE_CLOSE=5
DS_PUBLISH_RATE_PER_SEC=100
DS_PUBLISH_RATE_BURST=200
DS_UPGRADES_PER_IP_PER_MIN=120
DS_AUTH_FAILURES_PER_IP_PER_MIN=30
